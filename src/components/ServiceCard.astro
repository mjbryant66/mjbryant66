---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-lg p-8 hover:border-gold transition-colors shadow-sm">
  <h3 class="text-2xl font-serif font-semibold mb-4 text-navy">{title}</h3>
  <p class="text-gray-700 mb-6 leading-relaxed">{description}</p>
  <a
    href={href}
    class="inline-flex items-center text-gold font-medium hover:text-yellow-600 transition-colors"
  >
    Learn more
    <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
</div>
