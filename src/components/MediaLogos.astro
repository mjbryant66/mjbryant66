---
const mediaOutlets = [
  'New York Times',
  'CNN',
  'The Guardian',
  'CBC',
  'Global News',
  'CP24',
  'BNN',
  'Bloomberg News',
  'CBC Radio',
  'Globe and Mail',
  'Chicago Tribune',
  'Toronto Star',
  'Toronto Sun'
];
---

<section class="py-12 bg-gray-50 border-y border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-center text-sm font-semibold text-gray-600 uppercase tracking-wide mb-8">
      As Seen On
    </h2>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6 xl:grid-cols-7">
      {mediaOutlets.map(outlet => (
        <div class="flex items-center justify-center p-4 bg-gray-200 rounded border border-gray-300 h-16">
          <span class="text-xs font-medium text-gray-600 text-center leading-tight">
            {outlet}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
