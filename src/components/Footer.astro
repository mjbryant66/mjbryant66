---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/ai', label: 'AI Strategy' },
  { href: '/indigenous', label: 'Indigenous Law' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-white mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row justify-between items-center space-y-6 md:space-y-0">
      <!-- Contact Info -->
      <div class="text-center md:text-left">
        <p class="text-sm font-medium mb-2">© {currentYear} Michael J. Bryant</p>
        <p class="text-sm text-gray-400">
          <a href="mailto:mjb@mjbryant.ca" class="hover:text-gold transition-colors">
            mjb@mjbryant.ca
          </a>
        </p>
        <p class="text-sm text-gray-400 mt-1">Vancouver & Toronto, Canada</p>
      </div>

      <!-- Footer Navigation -->
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-sm text-gray-400 hover:text-gold transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
