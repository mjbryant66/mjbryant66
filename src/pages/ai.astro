---
import Layout from '../layouts/Layout.astro';
import MediaLogos from '../components/MediaLogos.astro';
---

<Layout
  title="AI Strategy"
  description="Your team is already using AI. The question is whether leadership has a plan—or is hoping for the best. I help small businesses, charities, and professional firms develop an AI strategy that fits their size and budget."
  currentPath="/ai"
>
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-navy mb-8">AI Strategy</h1>
      <div class="space-y-6 text-lg text-gray-700 leading-relaxed">
        <p class="text-xl font-medium text-navy">
          Your team is already using AI. The question is whether leadership has a plan—or is hoping for the best.
        </p>
        <p>
          I help small businesses, charities, and professional firms develop an AI strategy that fits their size and budget.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-12">
        <!-- Service 1 -->
        <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
          <h2 class="text-2xl font-serif font-semibold text-navy mb-4">AI Strategy Session</h2>
          <p class="text-gray-700 mb-6 leading-relaxed">
            60-90 minutes. We assess where you are, identify quick wins and risks, and clarify next steps.
          </p>
          <a
            href="/session"
            class="inline-block px-6 py-3 bg-gold text-navy rounded-md font-semibold hover:bg-yellow-500 transition-colors"
          >
            Request a Session
          </a>
        </div>

        <!-- Service 2 -->
        <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
          <h2 class="text-2xl font-serif font-semibold text-navy mb-4">AI Strategy & Readiness Assessment</h2>
          <p class="text-gray-700 leading-relaxed">
            2-3 weeks. Full review of current AI use, gaps, and opportunities. Ends with a practical roadmap and board-ready presentation.
          </p>
        </div>

        <!-- Service 3 -->
        <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
          <h2 class="text-2xl font-serif font-semibold text-navy mb-4">AI Adoption Support</h2>
          <p class="text-gray-700 leading-relaxed">
            Ongoing. Vendor evaluation, policy development, training, and implementation guidance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Background Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-semibold text-navy mb-6">Background</h2>
      <p class="text-lg text-gray-700 leading-relaxed">
        I've led digital transformation as CEO of Legal Aid BC and as a cabinet minister responsible for government technology strategy.
      </p>
    </div>
  </section>

  <!-- Media Logos -->
  <MediaLogos />

  <!-- Bottom CTA Section -->
  <section class="py-20 bg-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-serif font-semibold mb-6">Ready to Develop Your AI Strategy?</h2>
      <p class="text-lg mb-8 text-gray-300">
        Start with a 60-90 minute strategy session to assess your current situation and identify next steps.
      </p>
      <a
        href="/session"
        class="inline-block px-8 py-4 bg-gold text-navy rounded-md text-lg font-semibold hover:bg-yellow-500 transition-colors"
      >
        Request a Strategy Session
      </a>
    </div>
  </section>
</Layout>
