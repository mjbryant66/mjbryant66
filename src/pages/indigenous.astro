---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Indigenous Law"
  description="I advise First Nations, Indigenous organizations, and governments on rights, land claims, treaty negotiations, and economic development."
  currentPath="/indigenous"
>
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-navy mb-8">Indigenous Law</h1>
      <p class="text-xl text-gray-700 leading-relaxed">
        I advise First Nations, Indigenous organizations, and governments on rights, land claims, treaty negotiations, and economic development.
      </p>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-semibold text-navy mb-8">Services</h2>
      <ul class="space-y-4">
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-lg text-gray-700">Land claims and historic grievances</span>
        </li>
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-lg text-gray-700">Government-to-government negotiations</span>
        </li>
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-lg text-gray-700">Revenue-sharing and impact benefit agreements</span>
        </li>
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-lg text-gray-700">Consultation and accommodation</span>
        </li>
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-lg text-gray-700">Indigenous economic development and governance</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Experience Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-semibold text-navy mb-6">Experience</h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-8">
        Chief negotiator on settlements exceeding $100M. Former Minister responsible for Indigenous Affairs (Ontario). Advised Indigenous communities and Crown on major land claims including Ipperwash.
      </p>

      <h3 class="text-2xl font-serif font-semibold text-navy mb-4 mt-12">Credentials</h3>
      <ul class="space-y-3">
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700">Called to bar in British Columbia and Ontario</span>
        </li>
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700">M.A. in Political Science (Indigenous Rights), UBC</span>
        </li>
        <li class="flex items-start">
          <svg class="h-6 w-6 text-gold mr-3 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700">Published on Crown-Aboriginal fiduciary relationships and Aboriginal self-determination</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-serif font-semibold mb-6">Discuss Your Indigenous Law Needs</h2>
      <p class="text-lg mb-8 text-gray-300">
        Contact me to discuss land claims, treaty negotiations, or Indigenous governance matters.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-4 bg-gold text-navy rounded-md text-lg font-semibold hover:bg-yellow-500 transition-colors"
      >
        Contact
      </a>
    </div>
  </section>
</Layout>
