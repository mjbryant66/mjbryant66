---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  currentPath="/404"
>
  <section class="py-32 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-6xl font-serif font-bold text-navy mb-4">404</h1>
      <h2 class="text-3xl font-serif font-semibold text-gray-700 mb-6">Page Not Found</h2>
      <p class="text-xl text-gray-600 mb-10">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-block px-8 py-4 bg-gold text-navy rounded-md text-lg font-semibold hover:bg-yellow-500 transition-colors"
      >
        Go to Homepage
      </a>
    </div>
  </section>
</Layout>
